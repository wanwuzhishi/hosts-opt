    },
    {
      "name": "maxiaof",
      "url": "https://raw.githubusercontent.com/maxiaof/github-hosts/master/hosts"
    }
  ],
  "ip_pools": [
    {
      "name": "IPDB-bestcf",
      "url": "https://ipdb.api.030101.xyz/?type=bestcf",
      "domains": [
        "cloudflare.com",
        "www.cloudflare.com",
        "cdnjs.cloudflare.com",
        "developers.cloudflare.com"
      ],
      "enabled": true,
      "max_candidates": 12
    },
    {
      "name": "Vercel-anycast",
      "domains": [
        "vercel.com",
        "www.vercel.com"
      ],
      "ips": [
        "76.76.21.21",
        "76.76.21.22",
        "76.76.21.123",
        "76.76.21.241",
        "64.239.109.1",
        "64.239.109.65",
        "64.239.109.193",
        "64.239.123.193",
        "66.33.60.35",
        "66.33.60.67",
        "66.33.60.193"
      ],
      "enabled": true,
      "max_candidates": 12
    },
    {
      "name": "NotionFaster-proxy",
      "domains": [
        "notion.so",
        "www.notion.so",
        "app.notion.com",
        "identity.notion.com",
        "img.notionusercontent.com",
        "msgstore-002.app.notion.com",
        "exp.notion.com",
        "audioprocessor.app.notion.com"
      ],
      "ips": [
        "198.44.178.123",
        "119.28.13.121",
        "101.32.183.34",
        "43.128.3.53"
      ],
      "enabled": false,
      "max_candidates": 8,
      "note": "Third-party TCP reverse proxy from notionfaster.org; opt-in only"
    }
  ],
  "doh": [
    "https://doh.pub/dns-query",
    "https://dns.alidns.com/resolve"
  ],
  "domains": [
    "github.com",
    "api.github.com",
    "raw.githubusercontent.com",
    "gist.githubusercontent.com",
    "codeload.github.com",
    "objects.githubusercontent.com",
    "media.githubusercontent.com",
    "github.githubassets.com",
    "avatars.githubusercontent.com",
    "camo.githubusercontent.com",
    "user-images.githubusercontent.com",
    "private-user-images.githubusercontent.com",
    "github.io"
  ],
  "port": 443,
  "fetch_timeout": 15,
  "doh_timeout": 4,
  "connect_timeout": 2.0,
  "samples": 3,
  "concurrency": 24,
  "max_candidates_per_domain": 15,
  "doh_min_candidates": 2,
  "enable_doh": true,
  "enable_ipv6": false,
  "use_system_hosts": true,
  "keep_previous_on_failure": true,
  "allow_untested_fallback": true,
  "sticky_previous": true,
  "switch_margin_ratio": 0.25,
  "switch_margin_ms": 15,
  "hosts_path_windows": "C:\\Windows\\System32\\drivers\\etc\\hosts",
  "hosts_path_posix": "/etc/hosts",
  "backup_keep": 10,
  "log_max_bytes": 1048576,
  "log_backup_count": 3
}
